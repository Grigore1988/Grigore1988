# API Configuration
API_BASE_URL=http://localhost:3000/api
WS_BASE_URL=ws://localhost:3001

# App Configuration
APP_NAME=TradePro
APP_VERSION=1.0.0

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_DEMO_MODE=true

# Market Data
DEFAULT_MARKET=US
DEFAULT_CURRENCY=USD

# Development
DEBUG_MODE=true
ENABLE_FLIPPER=true